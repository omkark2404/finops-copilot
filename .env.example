# ============================================================
# finops-copilot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finops-copilot
POSTGRES_USER=finops-copilot
POSTGRES_PASSWORD=changeme_in_production

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Centralized Storage Layer ---
DATA_DIR=./data
DUCKDB_PATH=./data/finops-copilot.duckdb
PARQUET_DIR=./data/parquet

# --- Google Gemini ---
# Required only for agent reasoning/explanation.
# Application works without this (MockLLMProvider is used when absent).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- JWT Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme_generate_a_real_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Default Admin User (created on first run) ---
ADMIN_EMAIL=admin@finops-copilot.local
ADMIN_PASSWORD=changeme_in_production

# --- Redis Job Queue ---
ARQ_REDIS_URL=redis://redis:6379/1
