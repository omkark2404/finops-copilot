# Local development. scripts/init_env.py fills the blank secrets.
APP_ENV=development
USE_LOCAL_SQLITE=true
DATA_DIR=./data
JWT_SECRET_KEY=
ADMIN_EMAIL=admin@finops-copilot.local
ADMIN_PASSWORD=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=15
LLM_MAX_CALLS=8
MAX_UPLOAD_BYTES=20000000
MAX_ROWS=100000
# Compose uses these; set USE_LOCAL_SQLITE=false for a standalone PostgreSQL server.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finopscopilot
POSTGRES_USER=finopsuser
POSTGRES_PASSWORD=
# DATABASE_URL_OVERRIDE=postgresql://user:password@host/database
